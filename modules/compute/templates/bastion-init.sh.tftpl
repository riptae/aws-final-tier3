#!/bin/bash
set -euo pipefail

# Bastion 접속 계정 비밀번호 초기화 (명령 추적 없이 실행)
echo 'ec2-user:password' | chpasswd

# SSH 비밀번호 인증을 기존 설정보다 먼저 적용
mkdir -p /etc/ssh/sshd_config.d
echo 'PasswordAuthentication yes' > /etc/ssh/sshd_config.d/00-password-auth.conf
if ! grep -qxF 'Include /etc/ssh/sshd_config.d/00-password-auth.conf' /etc/ssh/sshd_config; then
  sed -i '1i Include /etc/ssh/sshd_config.d/00-password-auth.conf' /etc/ssh/sshd_config
fi

# 설정 검사 후 SSH 서비스 시작 및 반영
sshd -t
systemctl enable --now sshd
systemctl reload sshd
sshd -T | grep '^passwordauthentication'

# Ansible
dnf install -y python3.12 python3.12-pip openssh-clients sshpass
python3.12 -m venv /opt/ansible
/opt/ansible/bin/python -m pip install --upgrade pip
/opt/ansible/bin/python -m pip install 'ansible-core>=2.19,<2.20'

# Inventory 및 각 Playbook을 개별 파일로 복원한다. 자동 실행하지 않는다.
DEPLOY_DIR=/home/ec2-user/deploy
install -d -m 0755 "$DEPLOY_DIR/playbooks" "$DEPLOY_DIR/templates"
printf '%s' '${inventory_b64}' | base64 --decode > "$DEPLOY_DIR/inventory.yml"
printf '%s' '${check_hosts_b64}' | base64 --decode > "$DEPLOY_DIR/playbooks/01-check-hosts.yml"
printf '%s' '${setup_web_b64}' | base64 --decode > "$DEPLOY_DIR/playbooks/02-setup-web.yml"
printf '%s' '${setup_app_b64}' | base64 --decode > "$DEPLOY_DIR/playbooks/03-setup-app.yml"
printf '%s' '${deploy_app_b64}' | base64 --decode > "$DEPLOY_DIR/playbooks/04-deploy-app.yml"
printf '%s' '${deploy_web_b64}' | base64 --decode > "$DEPLOY_DIR/playbooks/05-deploy-web.yml"
printf '%s' '${nginx_b64}' | base64 --decode > "$DEPLOY_DIR/templates/nginx.conf.j2"
printf '%s' '${app_service_b64}' | base64 --decode > "$DEPLOY_DIR/templates/app.service.j2"

# 실제 JAR와 환경 설정, 화면 파일은 이후 별도 업로드한다.
install -d -m 0700 "$DEPLOY_DIR/artifacts" "$DEPLOY_DIR/artifacts/web"
chmod 0644 "$DEPLOY_DIR/inventory.yml" "$DEPLOY_DIR/playbooks/"*.yml "$DEPLOY_DIR/templates/"*.j2
chown -R ec2-user:ec2-user "$DEPLOY_DIR"
/opt/ansible/bin/ansible --version
echo '준비 완료: /home/ec2-user/deploy에서 ansible-playbook으로 개별 실행하세요.'
