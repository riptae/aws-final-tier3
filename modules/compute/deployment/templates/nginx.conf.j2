# Ansible이 Inventory의 App 주소를 넣어 /etc/nginx/nginx.conf로 배포한다.
user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log;
pid /run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /var/log/nginx/access.log;
    sendfile on;

    # App 그룹 전체를 upstream으로 등록한다. 기본 분산 방식은 round-robin이다.
    upstream app_backend {
{% for host in groups['app'] %}
        server {{ hostvars[host]['ansible_host'] }}:{{ app_port }};
{% endfor %}
    }

    server {
        listen 80 default_server;
        server_name _;
        root /usr/share/nginx/html;
        index index.html;

        # HTML / JavaScript / CSS 정적 파일 제공
        location / {
            try_files $uri $uri/ =404;
        }

        # URI와 JSON 본문을 App으로 전달. /api/ 접두사를 유지한다.
        location /api/ {
            proxy_pass http://app_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_connect_timeout 5s;
            proxy_read_timeout 30s;
        }
    }
}
